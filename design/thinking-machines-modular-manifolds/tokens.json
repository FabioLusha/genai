{
  "meta": {
    "source": "https://thinkingmachines.ai/blog/modular-manifolds/",
    "site": "Thinking Machines Lab — Connectionism",
    "page": "Modular Manifolds (Jeremy Bernstein, Sep 26 2025)",
    "extracted": "2026-11-10",
    "method": "parsed inline <style> blocks + /assets/css/blog-post.min.css + computed font stack",
    "feel": "academic preprint rendered as a polished web essay: warm off-white paper, book serif body, quiet sans metadata, single 660px reading column with a left rail, marginalia instead of tooltips, no shadows, no rounded cards, hairline rules only"
  },

  "colors": {
    "brand": {
      "white": "#FFFFFF",
      "offWhite": "#F3F3F2",
      "lightGray": "#969696",
      "gray": "#676767",
      "darkGray": "#282828",
      "black": "#000000",
      "cobalt": "#0155BF",
      "azure": "#0387E7",
      "emerald": "#0E9972",
      "lime": "#9CC355",
      "yellow": "#FFCE52",
      "amber": "#F7A224",
      "red": "#EF402C"
    },
    "surface": {
      "bg": "#FFFFFF",
      "bgCode": "#F3F3F2",
      "bgSunken": "#F3F3F2",
      "hover": "rgba(128,128,128,0.12)",
      "selection": "rgba(0,0,0,0.12)"
    },
    "ink": {
      "fg": "#282828",
      "fg1": "#3C3836",
      "fg2": "#504945",
      "fg3": "#6B6866",
      "fg4": "#676767",
      "fg5": "#969696"
    },
    "semantic": {
      "text": "#282828",
      "textSecondary": "#504945",
      "textMuted": "#6B6866",
      "textFaint": "#676767",
      "textDisabled": "#969696",
      "link": "#676767",
      "linkHover": "#504945",
      "rule": "rgba(103,103,103,0.35)",
      "ruleFaint": "rgba(103,103,103,0.2)",
      "ruleTable": "#D9D9D9",
      "footerRule": "rgba(103,103,103,0.1)",
      "codeInline": "#AD2111",
      "codeBlockText": "#6B6866"
    },
    "syntax": {
      "red": "#CB071D",
      "blue": "#0277AA",
      "green": "#7EAC21",
      "magenta": "#AE166B",
      "comment": "#6F7D8D",
      "namespace": "#6b1e3c",
      "yellow": "#a47d00",
      "aqua": "#1b8ea6",
      "orange": "#c44d5a",
      "gray": "#5f6672"
    },
    "dataSeries": {
      "red": "#AD2111",
      "green": "#9CC355",
      "yellow": "#b57614",
      "blue": "#0E9EE4",
      "purple": "#8f3f71",
      "aqua": "#427b58",
      "orange": "#af3a03",
      "gray": "#817d79"
    }
  },

  "typography": {
    "families": {
      "serif": "\"Iowan Old Style BT\", Georgia, \"Times New Roman\", serif",
      "sans": "\"GT America\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
      "mono": "\"GT America Mono\", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
      "logo": "\"Chakra Petch\", \"GT America\", sans-serif"
    },
    "files": {
      "serifRegular": "assets/fonts/iowan-old-style_regular.woff2",
      "serifBold": "assets/fonts/iowan-old-style_bold.woff2",
      "sansRegular": "assets/fonts/GT-America-Standard-Regular.latin.902b7d02c7347949.woff2",
      "logoMedium": "assets/fonts/chakra-petch-v12-latin-500.woff2"
    },
    "note": "Body copy is the serif; all UI chrome (nav, metadata, captions, toc, footer, tables) is the sans. The logo is the only place Chakra Petch appears.",
    "scale": {
      "articleTitle":  { "size": "30px",   "sizeRem": "1.875rem", "weight": 600, "lineHeight": 1.4,  "family": "serif" },
      "subtitle":      { "size": "24px",   "sizeRem": "1.5rem",   "weight": 400, "lineHeight": 1.5,  "family": "serif", "style": "italic" },
      "h2":            { "size": "23.2px", "sizeRem": "1.45rem",  "weight": 600, "lineHeight": 1.4,  "family": "serif" },
      "h3":            { "size": "21.6px", "sizeRem": "1.35rem",  "weight": 400, "lineHeight": 1.4,  "family": "serif", "style": "italic" },
      "h4":            { "size": "15.52px","sizeRem": "0.97rem",  "weight": 400, "lineHeight": 1.4,  "family": "serif", "style": "italic" },
      "body":          { "size": "17px",   "sizeRem": "1.0625rem","weight": 400, "lineHeight": 1.6,  "family": "serif" },
      "bodyLarge":     { "size": "20px",   "sizeRem": "1.25rem",  "weight": 400, "lineHeight": 1.5,  "family": "sans" },
      "caption":       { "size": "13px",   "sizeRem": "0.8125rem","weight": 400, "lineHeight": 1.4,  "family": "sans" },
      "toc":           { "size": "13px",   "sizeRem": "0.8125rem","weight": 400, "lineHeight": 1.4,  "family": "sans" },
      "meta":          { "size": "15px",   "sizeRem": "0.9375rem","weight": 400, "lineHeight": "17px","family": "sans", "letterSpacing": "0.24px" },
      "nav":           { "size": "15px",   "sizeRem": "0.9375rem","weight": 400, "lineHeight": 1.3,  "family": "sans", "letterSpacing": "-0.01em" },
      "footer":        { "size": "15px",   "sizeRem": "0.9375rem","weight": 400, "lineHeight": 1.5,  "family": "sans", "letterSpacing": "-0.01em" },
      "logo":          { "size": "17px",   "sizeRem": "1.0625rem","weight": 500, "lineHeight": "25px","family": "logo", "letterSpacing": "1.7px" },
      "codeInline":    { "size": "0.9em",  "family": "mono" },
      "codeBlock":     { "size": "13px",   "lineHeight": 1.4, "family": "mono" }
    }
  },

  "spacing": {
    "base": "4px",
    "scale": ["2px", "4px", "8px", "12px", "13px", "16px", "20px", "24px", "32px", "50px", "56px", "144px"],
    "paragraph": "1.45rem",
    "heading": {
      "h2": { "top": "3.1rem",  "bottom": "1.2rem" },
      "h3": { "top": "2.8rem",  "bottom": "1.05rem" },
      "h4": { "top": "2.2rem",  "bottom": "0.8rem" }
    },
    "list": { "top": "1rem", "bottom": "1.2rem", "itemGap": "0.2rem", "ulIndent": "1.5rem", "olIndent": "2rem" },
    "figureCaptionGap": "13px",
    "footerTop": "9rem",
    "paginatorTop": "3.5rem",
    "contentPadding": "1.3rem"
  },

  "layout": {
    "readingColumn": "660px",
    "postShell": { "max": "950px", "breakpoints": { "1200": "970px", "1400": "990px", "1600": "1010px", "1800": "1030px" } },
    "pagePadding": "1rem",
    "headerHeight": { "mobile": "50px", "desktop": "54px" },
    "titleMax": "710px",
    "coverMax": "800px",
    "toc": { "width": "210px", "gap": "34px", "gutter": "1.3rem", "stickyTop": "2rem" },
    "sidenote": { "width": { "default": "230px", "1200": "240px", "1400": "250px", "1600": "275px", "1800": "300px" }, "gap": "64px" },
    "footer": { "maxWidth": "952px", "columns": 5, "columnGap": "clamp(1rem, 2.5vw, 2rem)" },
    "grid": "minmax(0,1fr) minmax(0,660px) minmax(0,1fr) — left rail | text | margin rail"
  },

  "radii": { "codeBlock": "0.45rem", "video": "12px", "pill": "999px", "kbd": "0.2rem", "tocExpander": "4px" },

  "borders": {
    "hairline": "1px solid rgba(103,103,103,0.35)",
    "blockquote": "2px solid rgba(103,103,103,0.35)",
    "epigraph": "3px solid #969696",
    "table": "no vertical rules; 1px #D9D9D9 bottom border per row"
  },

  "elevation": {
    "shadows": "none — depth comes from a white page, hairline rules, and the F3F3F2 code surface",
    "focus": "inset 0 0 0 1px rgba(103,103,103,0.55)"
  },

  "motion": {
    "pageFadeIn": "fadeIn 0.6s ease-in-out",
    "link": "color 0.3s ease-in-out, text-decoration-color 0.3s ease-in-out",
    "toc": "color 0.2s ease-in-out, opacity 0.2s ease-in-out",
    "tocMarker": "transform 0.28s cubic-bezier(0.22,1,0.36,1), opacity 0.16s ease-in-out",
    "headingAnchor": "opacity 0.15s ease-in-out",
    "headerHide": "transform 0.22s cubic-bezier(0.22,1,0.36,1)",
    "reducedMotion": "all transitions disabled via prefers-reduced-motion"
  },

  "components": {
    "page": { "bg": "#FFFFFF", "text": "#282828", "font": "serif", "size": "17px", "lineHeight": 1.6 },
    "header": {
      "position": "fixed",
      "bg": "#FFFFFF",
      "logo": "THINKING MACHINES · Chakra Petch 17px / 500 / 1.7px tracking / #676767",
      "links": ["Inkling", "Tinker", "Connectionism", "News", "Join us"],
      "link": "15px sans / #3C3836 / underline 20% on hover",
      "breakpoint": ">=641px shows nav, below shows hamburger"
    },
    "articleHeader": {
      "align": "center",
      "title": "articleTitle token, max 710px, text-wrap balance",
      "author": "15px sans, #282828, letter-spacing .24px, linked with 20% underline on hover",
      "date": "15px sans, #3C3836, sits on its own line under author",
      "cover": "full-width image inside 800px, margin 2rem 0, no radius, no shadow"
    },
    "toc": {
      "rail": "left grid column, right-aligned, sticky 2rem from top, 210px + 1.3rem gutter",
      "item": "13px sans, #676767, 0.7rem apart",
      "active": "#282828 plus a 4px dot marker in the gutter",
      "hiddenBelow": "1280px (rail collapses, article centers)",
      "subLevels": "indented .75rem / 1.25rem, revealed on hover of the chevron"
    },
    "article": {
      "paragraph": "23.2px bottom margin, no indent, no drop cap",
      "headingAnchor": "\"#\" appears 1.2rem to the left at 65% opacity on hover",
      "link": "#676767, underline at 30% opacity, hover #504945",
      "strong": "serif bold 700",
      "em": "serif italic",
      "blockquote": "2px left rule at 35%, #504945 text, 1rem left inset, 1.25rem padding",
      "hr": "1px #676767, 1rem above/below",
      "table": "sans 13px, 1px #676767 cell borders, .75rem padding, header cell #F3F3F2, 18ch min column",
      "inlineCode": "mono .9em, #AD2111, no background",
      "codeBlock": "#F3F3F2 surface, .45rem radius, 13px mono #6B6866, 1rem/2rem padding, language label 11px sans #676767 top-left",
      "figure": "image max 800px centered, caption 13px sans #6B6866, 13px below, prefixed \"Figure N: \" in 500 weight",
      "math": "KaTeX, inline .9em, display blocks padded .45rem vertical",
      "sidenote": "float right into margin rail, 13px sans-ish serif, superscript number in #676767, 230-300px wide, 64px gutter"
    },
    "paginator": { "grid": "3 equal columns (prev / back to top / next)", "font": "15px sans #676767", "top": "3.5rem" },
    "footer": {
      "topMargin": "9rem",
      "columns": 5 at >800px, 2 below",
      "heading": "15px sans #676767",
      "link": "15px sans #3C3836, 20% underline on hover",
      "copyright": "15px sans #676767, 3rem above"
    },
    "selection": { "background": "rgba(0,0,0,0.12)" },
    "scrollbar": { "width": "8px", "thumb": "#676767", "thumbHover": "#3C3836", "track": "#FFFFFF" }
  },

  "responsive": {
    "641px": "top nav appears, hamburger disappears",
    "769px": "header height 54px, wrapper side padding 1rem",
    "800px": "footer 5 columns",
    "1200px": "post shell 970px, sidenote 240px",
    "1280px": "left toc visible",
    "1400px": "post shell 990px, sidenote 250px",
    "1600px": "post shell 1010px, sidenote 275px",
    "1800px": "post shell 1030px, sidenote 300px",
    "<=768px": "article padding .33rem, toc hidden, sidenotes become tap-to-reveal blocks"
  }
}
